VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SITE_URL=http://localhost:5173

# Cashfree checkout SDK mode — must match the backend's CASHFREE_ENV
# (SANDBOX/PRODUCTION) exactly, or checkout fails with
# "payment_session_id_invalid" (a session created in one Cashfree
# environment doesn't exist in the other). Baked in at build time, so
# .env.production (not this file) is what production builds actually read.
VITE_CASHFREE_MODE=sandbox

# web/server (Node SSR render host, plan §1a) — its own narrow DB access,
# read/write on page_cache only.
DATABASE_URL=postgresql://localhost:5432/ninekaret_dev
SSR_CACHE_TTL_SECONDS=600
WEB_PORT=5173

# Tawk.to live chat widget URL (https://embed.tawk.to/<property>/<widget>); empty = off.
VITE_TAWK_EMBED_URL=
