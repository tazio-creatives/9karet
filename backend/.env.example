NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://localhost:5432/ninekaret_dev

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Leave unset for local dev (single host "localhost" already shares cookies
# across ports). Set when the storefront/admin/API are split across
# subdomains, e.g. COOKIE_DOMAIN=.example.com — otherwise session cookies set
# by the API won't be sent back on requests from the other subdomains.
COOKIE_DOMAIN=

ADMIN_SESSION_SECRET=change-me-in-production
ADMIN_SESSION_COOKIE_NAME=ninekaret_admin_sid
ADMIN_SESSION_MAX_AGE_HOURS=12

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
ADMIN_LOGIN_RATE_LIMIT_MAX=10

CUSTOMER_SESSION_SECRET=change-me-in-production
CUSTOMER_SESSION_COOKIE_NAME=ninekaret_customer_sid
CUSTOMER_SESSION_MAX_AGE_HOURS=720

GUEST_CART_SESSION_COOKIE_NAME=ninekaret_cart_sid
GUEST_CART_SESSION_MAX_AGE_DAYS=90

# OTP_PROVIDER=stub logs the code to the console instead of sending a real SMS.
OTP_PROVIDER=stub
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_DAY=10
OTP_SEND_RATE_LIMIT_PER_IP=20

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# METAL_RATE_PROVIDER=stub returns a mock 24K rate instead of calling a real
# feed — this is a dev/test escape hatch only. Any other value is ignored:
# goldRateService.js always tries OroPocket first, then GoldAPI (below) as a
# temporary fallback, then the last known valid rate. Leave unset/"stub" for
# local dev.
METAL_RATE_PROVIDER=stub
GOLD_RATE_SYNC_CRON="*/15 * * * *"
GOLDAPI_ACCESS_TOKEN=
# GoldAPI's price_gram_24k is the raw international spot rate with no Indian
# import duty applied — confirmed by comparing it directly against
# OroPocket's actual domestic quote. This is added on top before GoldAPI's
# rate is used anywhere (fallback pricing or the comparison log).
GOLDAPI_IMPORT_DUTY_PERCENT=16

# OroPocket — primary gold-rate source, no API key required.
OROPOCKET_BASE_URL=https://api.oropocket.com
METAL_RATE_FETCH_TIMEOUT_MS=8000
METAL_RATE_FETCH_RETRIES=2
METAL_RATE_RETRY_BASE_DELAY_MS=400
GOLD_RATE_MAX_DEVIATION_PERCENT=10
GOLD_RATE_COMPARISON_LOGGING=true

# Checkout / inventory reservation (Phase 10, plan §11)
RESERVATION_TTL_MINUTES=15
RESERVATION_SWEEP_CRON="* * * * *"
SHIPPING_ESTIMATE_MIN_DAYS=3
SHIPPING_ESTIMATE_MAX_DAYS=7

# Payment (Phase 11, plan §11)
# PAYMENT_PROVIDER=stub uses the dev-only simulate flow (no real gateway).
# Set to "cashfree" to use the real Cashfree provider below.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret

# Cashfree — get sandbox App ID / Secret Key from the Cashfree dashboard.
# Never commit real values. CASHFREE_ENV must be explicitly PRODUCTION to
# go live; SANDBOX is the safe default.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=SANDBOX

# Storefront's own base URL — used to build Cashfree's post-payment
# return_url, not the API's own PORT above.
WEB_APP_BASE_URL=http://localhost:5173

# Shipping (Phase 13, plan §11b)
SHIPPING_PROVIDER=stub
SHIPPING_WEBHOOK_SECRET=dev-only-shipping-webhook-secret

# Delhivery — real courier provider (Phase 3). Only read when
# SHIPPING_PROVIDER=delhivery. Never commit real values.
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_PICKUP_LOCATION=Box Diamonds Warehouse
DELHIVERY_TRACKING_SYNC_CRON=*/15 * * * *

# Reverse pickup (return collection) — the warehouse address Delhivery
# delivers a picked-up return TO, distinct from DELHIVERY_PICKUP_LOCATION
# (a registered warehouse name only). Required for POST /admin/orders/:id/
# return-request/reverse-pickup to work against the real Delhivery provider.
DELHIVERY_RETURN_NAME=Box Diamonds Warehouse
DELHIVERY_RETURN_ADDRESS=
DELHIVERY_RETURN_PINCODE=
DELHIVERY_RETURN_CITY=
DELHIVERY_RETURN_STATE=
DELHIVERY_RETURN_PHONE=

# Email (plan §12). ses reuses the AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# env vars (same credential pair the S3 storage provider reads) unless an
# IAM role is attached instead, in which case leave those unset.
EMAIL_PROVIDER=stub
SES_REGION=ap-south-1
SES_FROM_EMAIL=
SES_FROM_NAME=9Karet

# smtp — generic SMTP (e.g. Gmail with an App Password), no SES sandbox/
# per-recipient-verification wait. SMTP_FROM_EMAIL defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=9Karet

# Storage + AI image pipeline (Phase 15, plan §2/§9/§10)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
UPLOADS_PUBLIC_BASE_URL=http://localhost:4000/uploads
MAX_UPLOAD_SIZE_MB=10
AI_IMAGE_PROVIDER=stub

# Jewellery photo quality enhancement — OpenAI Images Edit API.
# Get a key at https://platform.openai.com/api-keys — never commit the real value.
# Server-side only; the key is never sent to or read by the frontend.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# AI Image Studio — vision-based jewellery analysis. No default: must be a
# vision-capable model that supports structured JSON output (e.g. gpt-4o).
OPENAI_VISION_MODEL=
AI_STUDIO_CATEGORY_CONFIDENCE_THRESHOLD=0.7
AI_STUDIO_GENERATION_CONCURRENCY=4
